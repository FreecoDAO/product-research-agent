# Freeco AI — Product Research Agent Configuration
# Copy this file to .env and fill in your credentials

# Novita AI — DeepSeek V4 Flash (OpenAI-compatible)
OPENAI_API_KEY=your_novita_api_key_here
OPENAI_BASE_URL=https://api.novita.ai/openai

# Model configuration
MODEL_NAME=deepseek/deepseek-v4-flash
REASONING_EFFORT=high
MAX_TOKENS=4096
SERVICE_TIER=default

# Tavily (web search for product discovery)
# Get a free key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Phoenix observability (optional)
# PHOENIX_API_KEY=
